{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Treemap: products in each aisle, split by brand. Each aisle (type of product) has its own hue (blue or orange/yellow family only, so red-green colour-blind readers can tell them apart) and a header in a dark shade of it; inside an aisle, darker blocks hold more products.",
  "autosize": "none",
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "signals": [
    {
      "name": "width",
      "init": "max(containerSize()[0], 300)",
      "on": [
        {
          "events": "window:resize",
          "update": "max(containerSize()[0], 300)"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "brands",
      "url": "data/brand_tree.csv",
      "format": {
        "type": "csv",
        "parse": {
          "products": "number"
        }
      }
    },
    {
      "name": "tree",
      "source": "brands",
      "transform": [
        {
          "type": "nest",
          "keys": [
            "aisle"
          ],
          "generate": true
        },
        {
          "type": "treemap",
          "field": "products",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 0,
          "paddingOuter": 0,
          "paddingTop": {
            "signal": "22"
          },
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "aisles",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "aisle"
          ],
          "fields": [
            "products"
          ],
          "ops": [
            "max"
          ],
          "as": [
            "amax"
          ]
        },
        {
          "type": "formula",
          "as": "share",
          "expr": "datum.products / datum.amax"
        },
        {
          "type": "formula",
          "as": "lum",
          "expr": "86 - 34 * datum.share"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "datum.brand == 'Other name brands' ? 'Other brands' : datum.brand == 'Other own brands' ? 'Other own brands' : datum.brand"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "hue",
      "type": "ordinal",
      "domain": [
        "Biscuits & cakes",
        "Bread",
        "Breakfast cereals",
        "Cheese",
        "Chips & salty snacks",
        "Confectionery",
        "Fruit, veg & legumes",
        "Ice cream & desserts",
        "Meat & seafood",
        "Milk & alternatives",
        "Muesli & protein bars",
        "Pasta, rice & grains",
        "Ready meals",
        "Sauces & condiments",
        "Soft drinks & juice",
        "Spreads",
        "Yoghurt"
      ],
      "range": [
        232,
        40,
        215,
        28,
        250,
        55,
        224,
        34,
        262,
        48,
        240,
        22,
        210,
        60,
        256,
        44,
        236
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "aisles"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "hcl(scale('hue', datum.key), 42, 36)"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "aisles"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "datum.y0 + 15"
          },
          "align": {
            "value": "center"
          },
          "text": {
            "signal": "datum.key"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 8"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#ffffff"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "hcl(scale('hue', datum.aisle), 30 + 22 * datum.share, datum.lum)"
          },
          "stroke": {
            "signal": "hcl(scale('hue', datum.aisle), 40, 30)"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Aisle': datum.aisle, 'Brand': datum.label, 'Products': datum.products}"
          },
          "fillOpacity": {
            "value": 1
          },
          "strokeOpacity": {
            "value": 0.18
          }
        },
        "hover": {
          "fillOpacity": {
            "value": 0.8
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "(datum.x1 - datum.x0) > 34 && (datum.y1 - datum.y0) > 16 ? datum.label : ''"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 6"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "signal": "datum.lum < 66 ? '#ffffff' : '#20242b'"
          }
        }
      }
    }
  ],
  "height": 480
}
