{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: median grams per 100 g of five nutrients for each supermarket aisle. Colour compares each aisle with the highest aisle for that nutrient.",
  "width": "container",
  "height": 440,
  "data": {"url": "data/products.csv"},
  "transform": [
    {"fold": ["sugar", "satfat", "salt", "fibre", "protein"], "as": ["nutrient", "raw"]},
    {"filter": "datum.raw != null && datum.raw !== ''"},
    {"calculate": "toNumber(datum.raw)", "as": "grams"},
    {"aggregate": [{"op": "median", "field": "grams", "as": "median"}], "groupby": ["aisle", "nutrient"]},
    {"joinaggregate": [{"op": "max", "field": "median", "as": "max"}], "groupby": ["nutrient"]},
    {"calculate": "datum.median / datum.max", "as": "relative"},
    {
      "calculate": "{'sugar': 'Sugar', 'satfat': 'Sat. fat', 'salt': 'Salt', 'fibre': 'Fibre', 'protein': 'Protein'}[datum.nutrient]",
      "as": "label"
    },
    {"calculate": "datum.nutrient == 'fibre' || datum.nutrient == 'protein' ? 'good' : 'limit'", "as": "kind"}
  ],
  "encoding": {
    "x": {
      "field": "label", "type": "nominal", "title": null,
      "sort": ["Sugar", "Sat. fat", "Salt", "Fibre", "Protein"],
      "axis": {"orient": "bottom", "labelAngle": 0, "domain": false, "ticks": false}
    },
    "y": {
      "field": "aisle", "type": "nominal", "title": null,
      "sort": ["Confectionery", "Biscuits & cakes", "Ice cream & desserts", "Muesli & protein bars", "Breakfast cereals", "Soft drinks & juice", "Spreads", "Yoghurt", "Sauces & condiments", "Milk & alternatives", "Fruit, veg & legumes", "Chips & salty snacks", "Ready meals", "Bread", "Cheese", "Pasta, rice & grains", "Meat & seafood"],
      "axis": {"domain": false, "ticks": false, "labelLimit": 170}
    }
  },
  "layer": [
    {
      "transform": [{"filter": "datum.kind == 'limit'"}],
      "mark": {"type": "rect", "stroke": "#fffdf8", "strokeWidth": 2},
      "encoding": {
        "color": {
          "field": "relative", "type": "quantitative",
          "scale": {"domain": [0, 1], "range": ["#fdf1e2", "#b0461a"]},
          "legend": {"title": "Eat less", "format": ".0%", "orient": "bottom", "direction": "horizontal", "gradientLength": 110}
        },
        "tooltip": [
          {"field": "aisle", "title": "Aisle"},
          {"field": "label", "title": "Nutrient"},
          {"field": "median", "title": "Median g per 100 g", "format": ".1f"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.kind == 'good'"}],
      "mark": {"type": "rect", "stroke": "#fffdf8", "strokeWidth": 2},
      "encoding": {
        "fill": {
          "field": "relative", "type": "quantitative",
          "scale": {"domain": [0, 1], "range": ["#eaf2f8", "#1f5f8b"]},
          "legend": {"title": "Eat more", "format": ".0%", "orient": "bottom", "direction": "horizontal", "gradientLength": 110}
        },
        "tooltip": [
          {"field": "aisle", "title": "Aisle"},
          {"field": "label", "title": "Nutrient"},
          {"field": "median", "title": "Median g per 100 g", "format": ".1f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 11},
      "encoding": {
        "text": {"field": "median", "type": "quantitative", "format": ".1f"},
        "color": {"condition": {"test": "datum.relative > 0.6", "value": "#ffffff"}, "value": "#1d2327"}
      }
    }
  ],
  "resolve": {"scale": {"color": "independent"}},
  "config": {"view": {"stroke": null}}
}
