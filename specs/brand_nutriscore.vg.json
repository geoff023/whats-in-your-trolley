{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Diverging stacked bar chart: Nutri-Score grades for all supermarket own brands, all name brands, and the ten brands with the most graded products. Healthier grades (A, B) extend left of zero, less healthy grades (D, E) extend right. An aisle filter compares brands within one aisle; rows with fewer than 8 graded products are hidden.",
  "width": "container",
  "height": 440,
  "data": {
    "url": "data/products.csv"
  },
  "transform": [
    {
      "filter": "datum.nutriscore != '' && datum.brand_type != 'Unknown' && (aisle == 'All aisles' || datum.aisle == aisle)"
    },
    {
      "calculate": "datum.brand_type == 'Supermarket own brand' ? 'All own brands' : 'All name brands'",
      "as": "overall"
    },
    {
      "calculate": "{'woolworths': 'Woolworths', 'coles': 'Coles', 'cadbury': 'Cadbury', \"arnott's\": \"Arnott's\", \"kellogg's\": \"Kellogg's\", 'macro': 'Macro (Woolworths)', 'heinz': 'Heinz', \"carman's\": \"Carman's\", 'chobani': 'Chobani', 'uncle tobys': 'Uncle Tobys'}[lower(datum.brand)] || null",
      "as": "single"
    },
    {
      "fold": [
        "overall",
        "single"
      ],
      "as": [
        "level",
        "row"
      ]
    },
    {
      "filter": "datum.row != null"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "row",
        "nutriscore"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "total"
        }
      ],
      "groupby": [
        "row"
      ]
    },
    {
      "filter": "datum.total >= 8"
    },
    {
      "calculate": "datum.n / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.nutriscore == 'A' || datum.nutriscore == 'B' ? datum.share : datum.nutriscore == 'C' ? datum.share / 2 : 0",
      "as": "left_part"
    },
    {
      "calculate": "datum.nutriscore == 'A' || datum.nutriscore == 'B' ? datum.share : 0",
      "as": "ab"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "left_part",
          "as": "left"
        },
        {
          "op": "sum",
          "field": "ab",
          "as": "healthy"
        }
      ],
      "groupby": [
        "row"
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "share",
          "as": "cum"
        }
      ],
      "groupby": [
        "row"
      ],
      "sort": [
        {
          "field": "nutriscore"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.cum - datum.share - datum.left",
      "as": "x0"
    },
    {
      "calculate": "datum.cum - datum.left",
      "as": "x1"
    },
    {
      "calculate": "datum.row == 'All own brands' || datum.row == 'All name brands' ? 0 : 1",
      "as": "is_brand"
    }
  ],
  "encoding": {
    "y": {
      "field": "row",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "healthy",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 160,
        "labelFontWeight": {
          "condition": {
            "test": "indexof(datum.value, 'All ') == 0",
            "value": "bold"
          },
          "value": "normal"
        }
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "← healthier      share of products      less healthy →",
          "scale": {
            "domain": [
              -1.18,
              1
            ]
          },
          "axis": {
            "values": [
              -1,
              -0.5,
              0,
              0.5,
              1
            ],
            "labelExpr": "format(abs(datum.value), '.0%')",
            "grid": false
          }
        },
        "x2": {
          "field": "x1"
        },
        "color": {
          "field": "nutriscore",
          "type": "ordinal",
          "scale": {
            "domain": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "range": [
              "#1f3a5f",
              "#7d97b8",
              "#d9dcd8",
              "#eaa0ac",
              "#c8324b"
            ]
          },
          "legend": {
            "title": "Nutri-Score",
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "row",
            "title": "Brand"
          },
          {
            "field": "nutriscore",
            "title": "Grade"
          },
          {
            "field": "share",
            "title": "Share",
            "format": ".0%"
          },
          {
            "field": "total",
            "title": "Graded products"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#1b2430",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.nutriscore == 'A'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -5,
        "fontSize": 11,
        "color": "#1f3a5f",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "text": {
          "field": "healthy",
          "type": "quantitative",
          "format": ".0%"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "aisle",
      "value": "All aisles",
      "bind": {
        "input": "select",
        "name": "Compare within ",
        "options": [
          "All aisles",
          "Biscuits & cakes",
          "Bread",
          "Breakfast cereals",
          "Cheese",
          "Chips & salty snacks",
          "Confectionery",
          "Fruit, veg & legumes",
          "Ice cream & desserts",
          "Meat & seafood",
          "Milk & alternatives",
          "Muesli & protein bars",
          "Pasta, rice & grains",
          "Ready meals",
          "Sauces & condiments",
          "Soft drinks & juice",
          "Spreads",
          "Yoghurt"
        ]
      }
    }
  ]
}
